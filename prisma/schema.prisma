generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String              @id @default(cuid())
  firebaseUid   String              @unique
  email         String              @unique
  name          String
  role          Role                @default(CONSERJE)
  status        Status              @default(PENDING)
  assignedBy    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  requests      CredentialRequest[]
  shiftLogs     ShiftLog[]
  novedades     Novedad[]
}

model CredentialRequest {
  id           String     @id @default(cuid())
  userId       String
  desiredRole  Role
  reason       String?
  status       Status     @default(PENDING)
  submittedAt  DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ShiftLog {
  id         String     @id @default(cuid())
  userId     String
  type       ShiftType
  timestamp  DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Novedad {
  id            String    @id @default(cuid())
  userId        String
  timestamp     DateTime  @default(now())
  description   String
  entryMethod   String
  createdAt     DateTime  @default(now())
  isHighlighted Boolean   @default(false)

  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum Role {
  ADMIN
  CONSERJE
  MAYORDOMO
  NOCHERO
  JARDINERO
  PISCINERO
  MANTENIMIENTO
}

enum Status {
  PENDING
  APPROVED
  CANCELLED
  SUSPENDED
  REJECTED
}

enum ShiftType {
  IN
  OUT
}
